generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Provider {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  email        String?
  quoteConfigs QuoteConfig[]
  quotes       Quote[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@map("providers")
}

model QuoteConfig {
  id         String    @id @default(uuid())
  providerId String
  type       QuoteType
  isActive   Boolean   @default(true)
  provider    Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  solarConfig SolarConfig?
  quotes      Quote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([providerId, type])
  @@map("quote_configs")
}

model SolarConfig {
  id            String      @id @default(uuid())
  quoteConfigId String      @unique
  quoteConfig   QuoteConfig @relation(fields: [quoteConfigId], references: [id], onDelete: Cascade)

  // Tarifas residencial
  residentialEnergyCost    Float @default(0.15)
  residentialFixedCharge   Float @default(10)
  residentialTaxRate       Float @default(21)
  residentialInflationRate Float @default(4)

  // Tarifas industrial
  industrialEnergyCost    Float  @default(0.12)
  industrialFixedCharge   Float  @default(50)
  industrialDemandCharge  Float? @default(15)
  industrialTaxRate       Float  @default(21)
  industrialInflationRate Float  @default(4)

  // Tarifas agro
  agroEnergyCost    Float @default(0.13)
  agroFixedCharge   Float @default(30)
  agroTaxRate       Float @default(10.5)
  agroInflationRate Float @default(4)

  // Sistema
  panelPower        Int   @default(550)
  panelEfficiency   Float @default(21)
  systemLosses      Float @default(15)
  degradationRate   Float @default(0.5)
  peakSunHoursDay   Float @default(6)
  peakSunHoursNight Float @default(4)
  peakSunHoursMixed Float @default(5)

  // Equipamiento
  panelCost         Float @default(200)
  inverterCost      Float @default(500)
  inverterCostPerKw Float @default(300)

  // Operativo
  baseInstallationFee    Float @default(300)   // fijo por proyecto
  laborCostPerKw         Float @default(150)   // mano de obra por kW
  structureCostPerPanel  Float @default(45)    // estructura por panel

  // Multiplicadores de montaje (sobre costos operativos)
  mountingMultiplierRoofSheet Float @default(1.0)
  mountingMultiplierRoofTile  Float @default(1.2)
  mountingMultiplierGround    Float @default(1.3)
  mountingMultiplierCarport   Float @default(1.4)

  // Extra por tipo de sistema
  systemExtraCostOffGrid Float @default(400)
  systemExtraCostHybrid  Float @default(600)

  // Margen
  marginPercentage Float @default(20)

  // Financiamiento
  financingEnabled      Boolean @default(true)
  downPaymentPercentage Float   @default(20)
  interestRate          Float   @default(8)
  termMonths            Int     @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("solar_configs")
}

model Quote {
  id            String      @id @default(uuid())
  providerId    String
  quoteConfigId String
  type          QuoteType
  customerEmail String
  customerName  String
  customerPhone String?
  status        QuoteStatus @default(PENDING)
  expiresAt     DateTime?
  input         Json
  result        Json
  provider    Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  quoteConfig QuoteConfig @relation(fields: [quoteConfigId], references: [id], onDelete: Cascade)
  lead        Lead?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([providerId])
  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
  @@map("quotes")
}

model Lead {
  id      String     @id @default(uuid())
  quoteId String     @unique
  status  LeadStatus @default(NEW)
  notes   String?    @db.Text
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

enum QuoteType {
  SOLAR
  GYM
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}
